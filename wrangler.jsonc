{
  "name": "plain-pond-dcc1",
  "main": "./dist/index.js",
  "assets": {
    "directory": "./dist"
  },
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  "vars": {
    "EXAMPLE_VALUE": "example_value"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "royal-feather-a0a3-d1",
      "database_id": "6f10faca-2a81-4c67-9bbe-306cafd9bc4d"
    }
  ],
  "workflows": [
    {
      "name": "plain-pond-dcc1-customer-workflow",
      "binding": "CUSTOMER_WORKFLOW",
      "class_name": "CustomerWorkflow"
    }
  ]
}
